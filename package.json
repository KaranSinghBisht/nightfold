{
  "name": "nightfold",
  "version": "0.1.0",
  "private": true,
  "description": "Cross-chain Texas Hold'em where the losing hand is never revealed. Cards private on Midnight, chips on Base and Solana.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "compile": "compact compile contracts/nightfold.compact contracts/managed/nightfold",
    "typecheck": "compact compile --skip-zk contracts/nightfold.compact contracts/managed/nightfold-tc",
    "test": "NODE_OPTIONS='--experimental-vm-modules' vitest run",
    "proof:up": "docker compose up -d --wait proof-server",
    "env:up": "docker compose up -d --wait",
    "env:down": "docker compose down",
    "check:rank": "node src/handrank.check.mjs",
    "check:fuzz": "node src/handrank.fuzz.mjs 20000",
    "check:hand": "node src/hand.e2e.mjs",
    "check": "npm run typecheck && npm run check:rank && npm run check:fuzz && npm run check:hand && npm run check:muck && npm run check:escrow && npm run check:crosschain",
    "anvil": "anvil --port 8545 --silent",
    "check:escrow": "node src/evm/escrow.test.mjs",
    "check:crosschain": "node src/crosschain.e2e.mjs",
    "check:muck": "node src/muck.e2e.mjs"
  },
  "dependencies": {
    "@midnight-ntwrk/compact-runtime": "^0.16.0",
    "solc": "^0.8.36",
    "viem": "^2.56.0"
  }
}