{
  "name": "nightfold",
  "version": "0.1.0",
  "private": true,
  "description": "Cross-chain Texas Hold'em where the losing hand is never revealed. Cards private on Midnight, chips on Base and Solana.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "compile": "compact compile contracts/nightfold.compact contracts/managed/nightfold",
    "typecheck": "compact compile --skip-zk contracts/nightfold.compact contracts/managed/nightfold-tc",
    "test": "NODE_OPTIONS='--experimental-vm-modules' vitest run",
    "proof:up": "docker compose up -d --wait proof-server",
    "env:up": "docker compose up -d --wait",
    "env:down": "docker compose down",
    "check:rank": "node src/handrank.check.mjs",
    "check:fuzz": "node src/handrank.fuzz.mjs 20000",
    "check:hand": "node src/hand.e2e.mjs",
    "check": "npm run typecheck && npm run check:rank && npm run check:fuzz && npm run check:hand && npm run check:muck && npm run check:game && npm run check:engine && npm run check:escrow && npm run check:crosschain",
    "anvil": "anvil --port 8545 --silent",
    "check:escrow": "node src/evm/escrow.test.mjs",
    "check:crosschain": "node src/crosschain.e2e.mjs",
    "check:muck": "node src/muck.e2e.mjs",
    "check:game": "node src/game/game.test.mjs",
    "devnet": "./scripts/devnet.sh",
    "proof:real": "node src/midnight/realproof.mjs",
    "check:engine": "cd ui && npx tsx src/game/engine.test.mjs 400"
  },
  "dependencies": {
    "@midnight-ntwrk/compact-runtime": "0.16.0",
    "@midnight-ntwrk/midnight-js-contracts": "4.1.1",
    "@midnight-ntwrk/midnight-js-http-client-proof-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-indexer-public-data-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-level-private-state-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-network-id": "4.1.1",
    "@midnight-ntwrk/midnight-js-node-zk-config-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-types": "4.1.1",
    "@midnight-ntwrk/midnight-js-utils": "4.1.1",
    "@midnight-ntwrk/onchain-runtime-v3": "3.0.0",
    "@midnight-ntwrk/testkit-js": "4.1.1",
    "@midnight-ntwrk/wallet-sdk": "1.2.0",
    "@noble/hashes": "^2.4.0",
    "pino": "^9.0.0",
    "pino-pretty": "^13.0.0",
    "rxjs": "^7.8.2",
    "solc": "^0.8.36",
    "viem": "^2.56.0",
    "ws": "^8.18.0"
  },
  "resolutions": {
    "@midnight-ntwrk/wallet-sdk": "1.2.0",
    "@midnight-ntwrk/onchain-runtime-v3": "3.0.0"
  },
  "overrides": {
    "@midnight-ntwrk/wallet-sdk": "1.2.0",
    "@midnight-ntwrk/onchain-runtime-v3": "3.0.0"
  }
}