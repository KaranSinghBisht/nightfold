pragma language_version >= 0.20;
import CompactStandardLibrary;
import HandRank;

// ============================================================================
// Nightfold — cross-chain Texas Hold'em where the losing hand is never shown.
//
// The ledger only ever learns:
//   - that a hand was opened, with commitments to the deck, the board and
//     each seat's hole cards
//   - the RANK a player chose to publish at showdown, if any
//   - who won, and a payout attestation bound to (handId, winner)
//
// It never learns the cards. A player who loses proves only that they lost, or
// nothing at all.
//
// SECURITY MODEL (rewritten after the 2026-08-29 audit; see docs/security.md)
//
//   Every hand is opened by the dealer with a HandSetup that fixes the deck
//   commitment, the board, and BOTH seats' hole-card commitments before a
//   single action is possible. Players cannot choose their own cards (NF-003),
//   cannot substitute a board (NF-004), and cannot act for a seat they do not
//   hold, because each action proves knowledge of that seat's secret (NF-002).
//   beatOpponent reads the threshold from the ledger rather than taking it
//   from the caller (NF-005), and the three resolutions are mutually exclusive.
// ============================================================================

// ---- hand state ------------------------------------------------------------

/**
 * Everything about a hand that must be fixed before anyone acts. Written once
 * by the dealer; immutable thereafter.
 */
export struct HandSetup {
  // Commitment to the full shuffled deck, published before any card is dealt,
  // so the deal is verifiable after the hand from the opening.
  deckCommit: Bytes<32>;
  // Commitment to the five board cards. The board is public by the rules of
  // poker, so this is an unsalted hash anyone can recompute and check.
  boardCommit: Bytes<32>;
  // Per-seat hole-card commitments produced by the dealer. A player proves
  // their cards OPEN one of these; they cannot invent cards.
  hole0Commit: Bytes<32>;
  hole1Commit: Bytes<32>;
  // Per-seat authorisation keys, each H("nf:seatkey:", seatSecret). Only the
  // holder of the matching secret can act for that seat.
  seat0Key: Bytes<32>;
  seat1Key: Bytes<32>;
}

export ledger hands: Map<Bytes<32>, HandSetup>;
export ledger shownRanks: Map<Bytes<32>, Uint<32>>;
export ledger muckedSeats: Set<Bytes<32>>;
export ledger beatShown: Set<Bytes<32>>;
export ledger settledHands: Set<Bytes<32>>;
export ledger payoutAttest: Map<Bytes<32>, Bytes<32>>;
export ledger handsOpened: Counter;
export ledger handsSettled: Counter;

// ---- private inputs --------------------------------------------------------

// The secret proving the caller holds a seat. Never leaves the client.
witness seatSecret(): Bytes<32>;
// The hole cards the dealer dealt this seat, with the salt that opens the
// dealer's commitment to them.
witness holeCards(): Vector<2, Card>;
witness holeSalt(): Bytes<32>;

/** Hides the board commitment. See boardCommitment for why it must exist. */
witness boardSalt(): Bytes<32>;
// The five cards being claimed, and where each sits among the seven.
witness claimedHand(): Vector<5, Card>;
witness handPick(): Vector<5, Uint<8>>;

// ---- keys and commitments --------------------------------------------------

export circuit seatKeyOf(handId: Bytes<32>, seat: Uint<8>): Bytes<32> {
  return persistentHash<Vector<3, Bytes<32>>>(
    [pad(32, "nf:seat:"), handId, persistentHash<Uint<8>>(seat)]
  );
}

/** The public authorisation key derived from a seat secret. */
export circuit seatAuthKey(secret: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([pad(32, "nf:seatkey:"), secret]);
}

/** Binding + hiding commitment to two hole cards. Produced by the dealer. */
export circuit holeCommitment(cards: Vector<2, Card>, salt: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<4, Bytes<32>>>([
    pad(32, "nf:hole:"),
    persistentHash<Uint<8>>(cards[0].id),
    persistentHash<Uint<8>>(cards[1].id),
    salt
  ]);
}

/**
 * Commitment to the board.
 *
 * RA-007: this used to be unsalted, and a five-card ordered board has only
 * 52*51*50*49*48 = 311,875,200 preimages. One lookup table recovers the flop,
 * turn and river before betting finishes — a 32-byte digest cannot restore
 * entropy the input never had. The salt is what makes the commitment hiding;
 * it is revealed with the board at showdown.
 */
export circuit boardCommitment(board: Vector<5, Card>, salt: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<7, Bytes<32>>>([
    pad(32, "nf:board:"),
    salt,
    persistentHash<Uint<8>>(board[0].id),
    persistentHash<Uint<8>>(board[1].id),
    persistentHash<Uint<8>>(board[2].id),
    persistentHash<Uint<8>>(board[3].id),
    persistentHash<Uint<8>>(board[4].id)
  ]);
}

/** Exposes the evaluator so a client can pick its best five off-chain. */
export circuit handValue(hand: Vector<5, Card>): Uint<32> {
  return evaluate5(hand);
}

// ---- internal guards -------------------------------------------------------

/**
 * Proves the caller holds `seat` in this hand, and returns the seat's ledger
 * key. Every state-changing circuit goes through here — that is what closes
 * NF-002.
 */
circuit authoriseSeat(handId: Bytes<32>, seat: Uint<8>): Bytes<32> {
  assert(seat < 2, "seat out of range");
  assert(hands.member(disclose(handId)), "no such hand");

  const setup = hands.lookup(disclose(handId));
  const mine = seatAuthKey(seatSecret());
  const expected = seat == 0 ? setup.seat0Key : setup.seat1Key;
  assert(mine == expected, "not your seat");
  return disclose(seatKeyOf(handId, seat));
}

/** A seat may resolve exactly once, by exactly one of show / beat / muck. */
circuit assertUnresolved(key: Bytes<32>): [] {
  assert(!shownRanks.member(key), "seat already showed");
  assert(!beatShown.member(key), "seat already claimed the beat");
  assert(!muckedSeats.member(key), "seat already mucked");
}

/**
 * Verifies the caller's hole cards open the DEALER's commitment for this seat,
 * that the board matches the hand's committed board, and that the claimed five
 * are distinct cards drawn from those seven. Returns the claimed hand.
 *
 * Closes NF-003 (self-selected cards) and NF-004 (substituted board).
 */
circuit verifiedClaim(
  handId: Bytes<32>,
  seat: Uint<8>,
  board: Vector<5, Card>
): Vector<5, Card> {
  const setup = hands.lookup(disclose(handId));

  for (const i of 0..5) {
    checkCard(board[i]);
  }
  // The board must be the one this hand committed to.
  assert(boardCommitment(board, boardSalt()) == setup.boardCommit, "board does not match the hand");

  // The hole cards must open the dealer's commitment for this seat.
  const cards = holeCards();
  checkCard(cards[0]);
  checkCard(cards[1]);
  const expectedHole = seat == 0 ? setup.hole0Commit : setup.hole1Commit;
  assert(holeCommitment(cards, holeSalt()) == expectedHole,
         "hole cards do not open the dealt commitment");

  const src: Vector<7, Card> = [
    cards[0], cards[1],
    board[0], board[1], board[2], board[3], board[4]
  ];

  // RA-003: distinct POSITIONS are not distinct CARDS. Without this the
  // contract accepted a hand holding seven copies of the ace of spades and
  // ranked it happily. Twenty-one comparisons say the seven cards this claim
  // is drawn from are seven different cards.
  for (const i of 0..7) {
    for (const k of 0..7) {
      if (i < k) {
        assert(src[i].id != src[k].id, "the same card cannot appear twice");
      }
    }
  }

  // Each claimed card must sit at a DISTINCT position among the seven.
  const pick = handPick();
  const claimed = claimedHand();
  for (const i of 0..5) {
    assert(pick[i] < 7, "pick out of range");
    for (const k of 0..5) {
      if (i < k) {
        assert(pick[i] != pick[k], "duplicate card in claimed hand");
      }
    }
    for (const j of 0..7) {
      const at = pick[i] == (j as Uint<8>);
      assert(!at || (claimed[i].id == src[j].id), "claimed card not in hand");
    }
  }
  return claimed;
}

/** The hand id IS its setup, so the id cannot be claimed with other content. */
export circuit handIdFor(
  deckCommit: Bytes<32>,
  boardCommit: Bytes<32>,
  hole0Commit: Bytes<32>,
  hole1Commit: Bytes<32>,
  seat0Key: Bytes<32>,
  seat1Key: Bytes<32>
): Bytes<32> {
  return persistentHash<Vector<7, Bytes<32>>>([
    pad(32, "nf:handid:"),
    deckCommit, boardCommit, hole0Commit, hole1Commit, seat0Key, seat1Key
  ]);
}

// ---- circuits --------------------------------------------------------------

/**
 * The dealer opens a hand, fixing the deck, the board and both seats' cards
 * before anyone can act. Immutable once written.
 */
export circuit openHand(
  handId: Bytes<32>,
  deckCommit: Bytes<32>,
  boardCommit: Bytes<32>,
  hole0Commit: Bytes<32>,
  hole1Commit: Bytes<32>,
  seat0Key: Bytes<32>,
  seat1Key: Bytes<32>
): [] {
  // RA-006: openHand was unauthenticated, so anyone who learned an intended
  // hand id could occupy it first with their own seat keys and lock the real
  // dealer out. Rather than add a dealer role, the id is now DERIVED from the
  // setup: to claim an id you must supply exactly the setup that hashes to it,
  // which is the legitimate one. A front-runner can only store what the dealer
  // was going to store anyway.
  assert(disclose(handId) == handIdFor(
    deckCommit, boardCommit, hole0Commit, hole1Commit, seat0Key, seat1Key
  ), "hand id must bind its own setup");

  assert(!hands.member(disclose(handId)), "hand already open");
  assert(disclose(seat0Key) != disclose(seat1Key), "seats must differ");
  assert(disclose(hole0Commit) != disclose(hole1Commit), "seats must hold different cards");

  hands.insert(disclose(handId), HandSetup {
    deckCommit: disclose(deckCommit),
    boardCommit: disclose(boardCommit),
    hole0Commit: disclose(hole0Commit),
    hole1Commit: disclose(hole1Commit),
    seat0Key: disclose(seat0Key),
    seat1Key: disclose(seat1Key)
  });
  handsOpened.increment(1);
}

/**
 * A voluntary SHOW. Publishes the packed rank, which is what a player does at
 * a real showdown when they want the pot.
 *
 * Be precise about what this leaks: the packed rank encodes the category and
 * every tiebreaker, so publishing it publishes the hand's composition (though
 * not its suits). That is correct for a player choosing to show. A player who
 * does not want to reveal that uses muckHand or beatOpponent.
 */
export circuit revealHand(
  handId: Bytes<32>,
  seat: Uint<8>,
  board: Vector<5, Card>
): Uint<32> {
  const key = authoriseSeat(handId, seat);
  assertUnresolved(key);

  const claimed = verifiedClaim(handId, seat, board);

  // Publishing the rank is the entire point: it is what lets the pot move
  // while the cards stay in the muck. Declared explicitly so the disclosure
  // is a decision in the source, not an accident.
  const value = disclose(evaluate5(claimed));
  shownRanks.insert(key, value);
  return value;
}

/**
 * Beat the rank your opponent has already shown, WITHOUT publishing your own.
 *
 * The threshold is read from the ledger, never taken from the caller — passing
 * your own threshold was NF-005, and a losing hand could win by passing zero.
 * The chain learns only that the comparison held.
 */
export circuit beatOpponent(
  handId: Bytes<32>,
  seat: Uint<8>,
  board: Vector<5, Card>
): [] {
  const key = authoriseSeat(handId, seat);
  assertUnresolved(key);

  // The opponent must have shown; their published rank IS the threshold.
  const otherSeat = (seat == 0 ? 1 : 0) as Uint<8>;
  const otherKey = disclose(seatKeyOf(handId, otherSeat));
  assert(shownRanks.member(otherKey), "opponent has not shown");
  const threshold = shownRanks.lookup(otherKey);

  const claimed = verifiedClaim(handId, seat, board);

  // The ONLY thing that escapes this circuit is that the comparison held.
  // The rank itself never reaches the ledger.
  assert(evaluate5(claimed) > threshold, "hand does not beat the shown rank");
  beatShown.insert(key);
}

/**
 * Concede without revealing anything. No cards, no rank, no proof of holdings
 * — exactly what sliding your hand face down into the muck means.
 *
 * Still requires the seat secret: before the audit, anyone who knew a public
 * handId could muck someone else's hand and hand them the pot (NF-002).
 */
export circuit muckHand(handId: Bytes<32>, seat: Uint<8>): [] {
  const key = authoriseSeat(handId, seat);
  assertUnresolved(key);
  muckedSeats.insert(key);
}

/**
 * Resolves the hand and writes a payout attestation bound to (handId, winner),
 * so the EVM side can check the attestation commits to the outcome it is being
 * asked to pay rather than trusting the relayer's word.
 */
export circuit settle(handId: Bytes<32>): Uint<8> {
  assert(hands.member(disclose(handId)), "no such hand");
  assert(!settledHands.member(disclose(handId)), "hand already settled");

  const k0 = disclose(seatKeyOf(handId, 0));
  const k1 = disclose(seatKeyOf(handId, 1));

  const shown0 = shownRanks.member(k0);
  const shown1 = shownRanks.member(k1);
  const muck0 = muckedSeats.member(k0);
  const muck1 = muckedSeats.member(k1);
  const beat0 = beatShown.member(k0);
  const beat1 = beatShown.member(k1);

  assert(shown0 || muck0 || beat0, "seat 0 has not acted");
  assert(shown1 || muck1 || beat1, "seat 1 has not acted");

  // beatOpponent requires the opponent to have shown, so only one seat can
  // ever hold the beat. Asserted rather than assumed.
  assert(!(beat0 && beat1), "both seats claim the beat");

  // 0 = seat 0, 1 = seat 1, 2 = split.
  //
  // RA-009: both-muck used to fall through `muck1 ? 0` and hand the pot to
  // seat 0 — by the ORDER of the conditions, not by any rule, while the
  // comments and the UI both said split. If neither seat will claim the pot,
  // neither seat takes it.
  const winner = (muck0 && muck1) ? 2
               : muck1 ? 0
               : muck0 ? 1
               : beat0 ? 0
               : beat1 ? 1
               : (shownRanks.lookup(k0) > shownRanks.lookup(k1)) ? 0
               : (shownRanks.lookup(k1) > shownRanks.lookup(k0)) ? 1
               : 2;

  settledHands.insert(disclose(handId));
  payoutAttest.insert(
    disclose(handId),
    disclose(persistentHash<Vector<3, Bytes<32>>>([
      pad(32, "nf:payout:"),
      handId,
      persistentHash<Uint<8>>(winner as Uint<8>)
    ]))
  );
  handsSettled.increment(1);
  return winner as Uint<8>;
}
