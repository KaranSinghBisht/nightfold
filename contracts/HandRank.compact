pragma language_version >= 0.20;

module HandRank {
  import CompactStandardLibrary;

  // ============================================================================
  // Nightfold — five-card hand ranking.
  //
  // This is the piece that lets the loser muck. Both players prove the RANK of
  // their hand from committed hole cards; only the rank becomes public, so the
  // pot can move without either hand ever being revealed.
  //
  // Card encoding: card = rank * 4 + suit, rank 0..12 ('2'..'A'), suit 0..3.
  // Rank and suit arrive as witnesses and are checked against the card id, so
  // the circuit never needs integer division or modulo (both are awkward in
  // Compact, and the ledger-op width rules make them worse).
  //
  // Hand value packs a category and five ordered ranks into one integer:
  //   value = cat * 15^5 + t1*15^4 + t2*15^3 + t3*15^2 + t4*15 + t5
  // Ordering by (count desc, rank desc) makes the packed value a total order
  // over hands, so comparing two hands is a single integer comparison.
  // ============================================================================

  export struct Card {
    id:   Uint<8>;   // 0..51
    rank: Uint<8>;   // 0..12  ('2'=0 .. 'A'=12)
    suit: Uint<8>;   // 0..3
  }

  // Hand categories, higher is better.
  // 0 high card · 1 pair · 2 two pair · 3 trips · 4 straight
  // 5 flush · 6 full house · 7 quads · 8 straight flush
  // (Compact has no module-level `const`, so these are literals at the use site.)

  // ---- card well-formedness ---------------------------------------------------

  // Binds the witnessed rank/suit decomposition to the card id.
  export circuit checkCard(c: Card): [] {
    assert(c.rank < 13, "rank out of range");
    assert(c.suit < 4, "suit out of range");
    assert(c.id == (c.rank * 4 + c.suit) as Uint<8>, "card decomposition mismatch");
  }

  // ---- 5-element descending sort ---------------------------------------------

  // Compare-exchange: returns [max, min].
  export circuit cx(a: Uint<16>, b: Uint<16>): Vector<2, Uint<16>> {
    return a >= b ? [a, b] : [b, a];
  }

  // Descending sort of 5 elements as a 10-comparator bubble network, written
  // straight-line because Compact has no mutable locals. Each pass carries the
  // running minimum rightward, so pass k fixes position 5-k.
  //
  // A shorter 9-comparator network exists, but this one can be checked by hand
  // pass by pass, and the saving is one comparator.
  export circuit sort5(v: Vector<5, Uint<16>>): Vector<5, Uint<16>> {
    // pass 1 — pushes the global minimum to position 4
    const p0 = cx(v[0], v[1]);
    const p1 = cx(p0[1], v[2]);
    const p2 = cx(p1[1], v[3]);
    const p3 = cx(p2[1], v[4]);
    // pass 2 — over positions 0..3, fixes position 3
    const q0 = cx(p0[0], p1[0]);
    const q1 = cx(q0[1], p2[0]);
    const q2 = cx(q1[1], p3[0]);
    // pass 3 — over positions 0..2, fixes position 2
    const r0 = cx(q0[0], q1[0]);
    const r1 = cx(r0[1], q2[0]);
    // pass 4 — over positions 0..1
    const s0 = cx(r0[0], r1[0]);
    return [s0[0], s0[1], r1[1], q2[1], p3[1]];
  }

  // ---- division-free helpers --------------------------------------------------
  // Compact has no `/` or `%` operator, so anything that would divide is done
  // with a comparison ladder over the (very small) domain instead.

  // Recovers the count field from key = count*16 + rank, count in 1..4.
  export circuit countOf(key: Uint<16>): Uint<16> {
    return key >= 64 ? 4 : key >= 48 ? 3 : key >= 32 ? 2 : 1;
  }

  // Recovers the rank field from key = count*16 + rank.
  export circuit rankOf(key: Uint<16>): Uint<16> {
    return (key - (countOf(key) * 16) as Uint<16>) as Uint<16>;
  }

  // 12/count, exact for count in 1..4. Summing this over five cards yields
  // 12 * (number of distinct ranks), which identifies the hand shape.
  export circuit inv12(c: Uint<16>): Uint<16> {
    return c == 1 ? 12 : c == 2 ? 6 : c == 3 ? 4 : 3;
  }

  // ---- hand evaluation --------------------------------------------------------

  // How many of the five cards share rank `r`. Takes the rank rather than an
  // index because Compact vectors cannot be indexed by a runtime value.
  export circuit rankCount(cards: Vector<5, Card>, r: Uint<8>): Uint<8> {
    const c0 = cards[0].rank == r ? 1 : 0;
    const c1 = cards[1].rank == r ? 1 : 0;
    const c2 = cards[2].rank == r ? 1 : 0;
    const c3 = cards[3].rank == r ? 1 : 0;
    const c4 = cards[4].rank == r ? 1 : 0;
    return (c0 + c1 + c2 + c3 + c4) as Uint<8>;
  }

  // All five cards the same suit.
  export circuit isFlush(cards: Vector<5, Card>): Boolean {
    const s = cards[0].suit;
    return cards[1].suit == s && cards[2].suit == s
        && cards[3].suit == s && cards[4].suit == s;
  }

  // Five distinct ranks in sequence. `d` is ranks sorted descending.
  // Also matches the wheel (A-5-4-3-2), which ranks as a five-high straight.
  export circuit isStraight(d: Vector<5, Uint<16>>): Boolean {
    const run = (d[0] == (d[1] + 1) as Uint<16>)
             && (d[1] == (d[2] + 1) as Uint<16>)
             && (d[2] == (d[3] + 1) as Uint<16>)
             && (d[3] == (d[4] + 1) as Uint<16>);
    // wheel: A(12) 5(3) 4(2) 3(1) 2(0)
    const wheel = (d[0] == 12) && (d[1] == 3) && (d[2] == 2)
               && (d[3] == 1) && (d[4] == 0);
    return run || wheel;
  }

  // Packs category + five ordered ranks into a single comparable integer.
  export circuit packValue(cat: Uint<8>, t: Vector<5, Uint<16>>): Uint<32> {
    const base = (cat as Uint<32>) * 759375;          // 15^5
    return (base
          + (t[0] as Uint<32>) * 50625                // 15^4
          + (t[1] as Uint<32>) * 3375                 // 15^3
          + (t[2] as Uint<32>) * 225                  // 15^2
          + (t[3] as Uint<32>) * 15
          + (t[4] as Uint<32>)) as Uint<32>;
  }

  // Full five-card evaluation. Returns the packed hand value.
  export circuit evaluate5(cards: Vector<5, Card>): Uint<32> {
    for (const i of 0..5) {
      checkCard(cards[i]);
    }

    // Sort by (count desc, rank desc) so pairs/trips lead the tiebreakers.
    // key = count * 16 + rank keeps both fields in one sortable integer.
    const keys: Vector<5, Uint<16>> = [
      ((rankCount(cards, cards[0].rank) as Uint<16>) * 16 + (cards[0].rank as Uint<16>)) as Uint<16>,
      ((rankCount(cards, cards[1].rank) as Uint<16>) * 16 + (cards[1].rank as Uint<16>)) as Uint<16>,
      ((rankCount(cards, cards[2].rank) as Uint<16>) * 16 + (cards[2].rank as Uint<16>)) as Uint<16>,
      ((rankCount(cards, cards[3].rank) as Uint<16>) * 16 + (cards[3].rank as Uint<16>)) as Uint<16>,
      ((rankCount(cards, cards[4].rank) as Uint<16>) * 16 + (cards[4].rank as Uint<16>)) as Uint<16>
    ];
    const sortedKeys = sort5(keys);

    // Strip the count field back off to get the ordered ranks.
    const t: Vector<5, Uint<16>> = [
      rankOf(sortedKeys[0]), rankOf(sortedKeys[1]), rankOf(sortedKeys[2]),
      rankOf(sortedKeys[3]), rankOf(sortedKeys[4])
    ];

    // Straight detection needs ranks in plain descending order, not count order.
    const plain = sort5([
      cards[0].rank as Uint<16>, cards[1].rank as Uint<16>,
      cards[2].rank as Uint<16>, cards[3].rank as Uint<16>,
      cards[4].rank as Uint<16>
    ]);

    const flush = isFlush(cards);
    const straight = isStraight(plain);

    // Count shape: the top two counts identify the category unambiguously.
    const c0 = rankCount(cards, cards[0].rank);
    const c1 = rankCount(cards, cards[1].rank);
    const c2 = rankCount(cards, cards[2].rank);
    const c3 = rankCount(cards, cards[3].rank);
    const c4 = rankCount(cards, cards[4].rank);
    const maxCount = sort5([
      c0 as Uint<16>, c1 as Uint<16>, c2 as Uint<16>,
      c3 as Uint<16>, c4 as Uint<16>
    ])[0];

    // distinct ranks: sum of 1/count over the five cards, scaled by 12 to stay
    // in integers. 12/count is exact for count in {1,2,3,4}.
    const distinct = (inv12(c0 as Uint<16>) + inv12(c1 as Uint<16>)
                    + inv12(c2 as Uint<16>) + inv12(c3 as Uint<16>)
                    + inv12(c4 as Uint<16>)) as Uint<16>;   // 12 * distinct-count

    const isQuads = maxCount == 4;
    const isFull  = (maxCount == 3) && (distinct == 24);   // 2 distinct ranks
    const isTrips = (maxCount == 3) && (distinct == 36);   // 3 distinct ranks
    const isTwoPr = (maxCount == 2) && (distinct == 36);
    const isPair  = (maxCount == 2) && (distinct == 48);   // 4 distinct ranks

    // Wheel straights rank as five-high: force the ace to sort below the 5.
    const wheel = straight && (plain[0] == 12) && (plain[1] == 3);
    const st: Vector<5, Uint<16>> = wheel
      ? [3, 2, 1, 0, 0]
      : [plain[0], plain[1], plain[2], plain[3], plain[4]];

    const cat = (straight && flush) ? 8
              : isQuads             ? 7
              : isFull              ? 6
              : flush               ? 5
              : straight            ? 4
              : isTrips             ? 3
              : isTwoPr             ? 2
              : isPair              ? 1
              :                       0;

    // Straights and straight flushes are ranked by their high card alone.
    const tie: Vector<5, Uint<16>> = (straight && !isQuads && !isFull)
      ? st
      : [t[0], t[1], t[2], t[3], t[4]];

    return packValue(cat, tie);
  }
}
